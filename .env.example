# Copy to .env and fill in. Never commit .env.

# Anthropic — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Linear — get from https://linear.app/settings/api (Personal API keys)
LINEAR_API_KEY=lin_api_...
# Find your team UUID: visit a Linear issue, the URL contains the team identifier;
# or run a quick query in linear_client.py to list teams. UUID, not the short identifier.
LINEAR_TEAM_ID=00000000-0000-0000-0000-000000000000

# Folder the watcher monitors (absolute path recommended)
INBOX_DIR=/Users/you/notes/inbox

# Optional: which Anthropic model to use (default: claude-sonnet-4-6)
EXTRACTOR_MODEL=claude-sonnet-4-6
